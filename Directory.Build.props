<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <HIDMaestroRoot Condition="'$(HIDMaestroRoot)' == ''">$(MSBuildThisFileDirectory)..\HIDMaestro</HIDMaestroRoot>
    <HIDMaestroCoreProject>$(HIDMaestroRoot)\sdk\HIDMaestro.Core\HIDMaestro.Core.csproj</HIDMaestroCoreProject>
    <HIDMaestroCoreDll Condition="'$(HIDMaestroCoreDll)' == ''"></HIDMaestroCoreDll>
  </PropertyGroup>
</Project>
